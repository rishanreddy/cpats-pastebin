# .cpats.env — local config (never committed to git)
# Copy this file to .cpats.env and fill in your values.

# Your GitHub repo (owner/reponame)
GITHUB_REPO="rishanreddy/cpats-pastebin"

# Repo owner: fine-grained token, this repo only, Contents read and write.
# Repository collaborator: classic PAT with repo scope, or GitHub App token.
# See README.md for GitHub's fine-grained token limitations for collaborators.
#
# Public repo:   token needed only for --upload-output and clipboard_upload.sh
# Private repo:  token needed for everything (reads and writes)
GITHUB_TOKEN="ghp_YOUR_TOKEN_HERE"

# Your GitHub username — determines which scripts/ and outputs/ subfolder is yours
CPATS_USERNAME="rishanreddy"

# Branch (almost certainly leave this as main)
BRANCH="main"

# Optional location for loop state and pending-upload records.
# CPATS_STATE_DIR="/path/to/cpats-state"
